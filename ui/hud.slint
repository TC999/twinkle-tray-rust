// 亮度 HUD 浮层（equiv: origin/src/electron.js hotkeyOverlay 系列 + panel.scss 的 .overlay）。
// 半透明圆角浮层，显示当前亮度/特征值，2 秒后自动隐藏（由 Rust 侧定时器驱动 visible）。
import { Theme } from "theme.slint";

export component HudWindow inherits Window {
    // 窗口图标（equiv BrowserWindow.icon = logo.ico）。
    icon: @image-url("../assets/logo.png");

    in-out property <float> level: 50;
    in-out property <string> label: "";
    in-out property <bool> show-value: true;

    width: 120px;
    height: 56px;
    always-on-top: true;
    no-frame: true;
    background: transparent;

    Rectangle {
        border-radius: 8px;
        background: #cc1f1f1f;
        border-width: 1px;
        border-color: #44ffffff;

        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.label;
                font-size: 11px;
                color: #dddddd;
                horizontal-alignment: center;
                overflow: elide;
            }
            if (root.show-value) : Text {
                text: "\{round(root.level)}%";
                font-size: 18px;
                font-weight: 600;
                color: #ffffff;
                horizontal-alignment: center;
            }
            // 进度条（equiv HUD 的亮度条）
            bar := Rectangle {
                height: 3px;
                x: 12px;
                width: parent.width - 24px;
                border-radius: 1.5px;
                background: #44ffffff;
                Rectangle {
                    width: parent.width * clamp(root.level, 0, 100) / 100;
                    height: parent.height;
                    border-radius: 1.5px;
                    background: Theme.accent-medium;
                }
            }
        }
    }
}

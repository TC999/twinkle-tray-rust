// 设置窗口（equiv: origin/src/components/SettingsWindow.jsx + components/SettingsOption.jsx）。
//
// 结构：标题栏 + 左侧导航（7 页，对应源 getSidebar 的 7 项）+ 右侧滚动内容区。
// 内容由 Rust 侧按原版页面顺序构建成 SettingsItem 列表注入（数据驱动），
// 每个开关/下拉/按钮都与 SettingsWindow.jsx 的设置项一一对应。
import { Theme } from "theme.slint";
import { ComboBox, LineEdit, ScrollView } from "std-widgets.slint";

export enum SettingsItemKind {
    toggle,
    select,
    button,
    number,
    text,
    note,
    section,
}

export struct SettingsItem {
    kind: SettingsItemKind,
    key: string,
    title: string,
    description: string,
    toggle-value: bool,
    text-value: string,
    // 下拉选项：values 与 labels 同序一一对应（selected 回调只给显示文本，
    // Rust 侧按 labels 位置映射回 values，等价原版 <select> 的 value/option 对）
    option-values: [string],
    option-labels: [string],
    // 当前选中项下标（Rust 侧按 text-value 在 option-values 中查得；未知值回落 0）
    selected-index: int,
    button-label: string,
    disabled: bool,
}

export struct SettingsPage {
    id: string,
    label: string,
    glyph: string,
}

// 校准点（equiv settings.remaps[id].calibration[]：input 为滑块级别，output 为实际下发级别）
export struct SettingsCalibrationPoint {
    index: int,
    input: float,
    output: float,
}

// 显示器设置行（equiv renderMonitorInfo / 重命名 / 隐藏 / gamma / extend minimum / SDR）
export struct SettingsMonitorEntry {
    key: string,
    id: string,
    name: string,
    rename: string,
    hidden: bool,
    gamma: bool,
    sdr: bool,
    extend-minimum: bool,
    breakpoint: int,
    // 标题（equiv getInfoMonitors 的 monitor.name 原始名）
    title: string,
    // 亮度归一化的 remap min/max（equiv settings.remaps[id].min/max，0-100）
    remap-min: float,
    remap-max: float,
    // 连接方式（equiv getDebugMonitorType）
    connection: string,
    hdr: string,
    brightness: string,
    maximum: string,
    normalization: string,
    // equiv getInfoMonitors 的多行明细（Name/Internal Name/Communication/.../HDR）
    details: string,
    // 校准点（equiv getMonitorCalibration 的逐台列表）
    calibration: [SettingsCalibrationPoint],
}

export struct SettingsHotkey {
    id: string,
    accelerator: string,
    summary: string,
}

component NavItem inherits Rectangle {
    in property <string> label: "";
    in property <string> glyph: "";
    in property <bool> active: false;
    callback clicked;
    height: 34px;
    border-radius: 4px;
    background: root.active ? Theme.sidebar-item-hover : (ta.has-hover ? Theme.sidebar-item-hover : transparent);

    HorizontalLayout {
        padding-left: 10px;
        spacing: 10px;
        Text {
            text: root.glyph;
            font-family: "Segoe MDL2 Assets";
            font-size: 14px;
            color: Theme.text-mid;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            font-size: 13px;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Toggle inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);
    width: 40px;
    height: 20px;
    border-radius: 10px;
    background: root.checked ? Theme.accent-medium : Theme.button-bg;
    border-width: 1px;
    border-color: Theme.button-border;
    opacity: root.enabled ? 1 : 0.5;

    Rectangle {
        x: root.checked ? parent.width - 14px : 3px;
        y: 3px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.checked ? #ffffff : Theme.text-mid;
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { root.toggled(!root.checked); }
    }
}


// 归一化滑块（equiv Slider.jsx type="min"/"max"，height="short"：轨道 + 手柄，0-100）
component MiniSlider inherits Rectangle {
    in property <float> level: 50;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    callback changed(float);

    min-width: 60px;
    height: 20px;
    background: transparent;
    property <float> ratio: (root.maximum > root.minimum)
        ? clamp((clamp(root.level, root.minimum, root.maximum) - root.minimum) / (root.maximum - root.minimum), 0, 1)
        : 0;
    property <length> thumb-width: 8px;
    property <length> track-height: 3px;

    Rectangle {
        x: 0;
        y: (parent.height - root.track-height) / 2;
        width: parent.width;
        height: root.track-height;
        border-radius: root.track-height / 2;
        background: Theme.slider-track;
    }
    Rectangle {
        x: 0;
        y: (parent.height - root.track-height) / 2;
        width: parent.width * root.ratio;
        height: root.track-height;
        border-radius: root.track-height / 2;
        background: Theme.accent-medium;
    }
    Rectangle {
        x: (parent.width - root.thumb-width) * root.ratio;
        y: (parent.height - 16px) / 2;
        width: root.thumb-width;
        height: 16px;
        border-radius: 3px;
        background: Theme.accent-medium;
    }
    ta := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.set-from-x(self.mouse-x);
                return EventResult.accept;
            }
            if (e.kind == PointerEventKind.move && self.pressed) {
                root.set-from-x(self.mouse-x);
                return EventResult.accept;
            }
            EventResult.reject
        }
    }
    public function set-from-x(x: length) {
        if (root.maximum <= root.minimum) { return; }
        let usable = max(root.width - root.thumb-width, 1px);
        let r = clamp((x - root.thumb-width / 2) / usable, 0, 1);
        let v = round(root.minimum + r * (root.maximum - root.minimum));
        if (v != round(root.level)) {
            root.changed(v);
        }
    }
}

// SettingsOption（equiv SettingsOption.jsx：title + description + input 右侧控件）
component SettingsRow inherits Rectangle {
    in property <SettingsItem> item;
    callback toggle-changed(bool);
    callback choice-picked(string);
    callback button-clicked;
    background: transparent;

    height: Math.max(48px, layout.preferred-height + 16px);
    layout := VerticalLayout {
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 1;
                Text {
                    text: root.item.title;
                    font-size: 13px;
                    color: Theme.text;
                    wrap: word-wrap;
                }
                if (root.item.description != "") : Text {
                    text: root.item.description;
                    font-size: 11px;
                    color: Theme.text-mid;
                    wrap: word-wrap;
                }
            }
            if (root.item.kind == SettingsItemKind.toggle) : Toggle {
                checked: root.item.toggle-value;
                enabled: !root.item.disabled;
                toggled(v) => { root.toggle-changed(v); }
            }
            // 下拉（equiv <select>）：真实 ComboBox，选项来自 option-labels，
            // 选中项由 selected-index 绑定；selected 回调传显示文本，Rust 侧映射回选项值
            if (root.item.kind == SettingsItemKind.select) : ComboBox {
                width: 160px;
                enabled: !root.item.disabled;
                model: root.item.option-labels;
                current-index: root.item.selected-index;
                selected(label) => { root.choice-picked(label); }
            }
            if (root.item.kind == SettingsItemKind.button) : Rectangle {
                width: Math.max(80px, bl.preferred-width + 24px);
                height: 26px;
                border-radius: 4px;
                background: Theme.button-bg;
                border-width: 1px;
                border-color: Theme.button-border;
                bl := Text {
                    text: root.item.button-label;
                    font-size: 12px;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                TouchArea {
                    enabled: !root.item.disabled;
                    clicked => { root.button-clicked(); }
                }
            }
            if (root.item.kind == SettingsItemKind.number) : Rectangle {
                width: 70px;
                height: 26px;
                border-radius: 4px;
                background: Theme.button-bg;
                border-width: 1px;
                border-color: Theme.button-border;
                LineEdit {
                    text: root.item.text-value;
                    horizontal-alignment: center;
                    accepted(t) => { root.choice-picked(t); }
                }
            }
            if (root.item.kind == SettingsItemKind.text) : Rectangle {
                width: 150px;
                height: 26px;
                border-radius: 4px;
                background: Theme.button-bg;
                border-width: 1px;
                border-color: Theme.button-border;
                LineEdit {
                    text: root.item.text-value;
                    horizontal-alignment: center;
                    accepted(t) => { root.choice-picked(t); }
                }
            }
        }
    }

}


// 设置项列表（equiv SettingsWindow.jsx 每页的 SettingsOption 序列）。
//
// 抽成组件供全部页面共用：此前 general/features/time/updates/debug 页与
// monitors/hotkeys 页各写一份渲染分支，monitors 页的 items 因条件排除而
// 整段不渲染 —— 表现为「显示器设置」页除逐台卡片外没有全局设置项。
component SettingsItems inherits VerticalLayout {
    in property <[SettingsItem]> items: [];
    callback item-toggle(string, bool);
    callback item-choice(string, string);
    callback item-button(string);

    spacing: 4px;
    for item in root.items : VerticalLayout {
        spacing: 0px;
        if (item.kind == SettingsItemKind.section) : Rectangle {
            height: 34px;
            background: transparent;
            Text {
                text: item.title;
                font-size: 13px;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: bottom;
            }
        }
        if (item.kind == SettingsItemKind.note) : Text {
            text: item.title;
            font-size: 12px;
            color: Theme.text-mid;
            wrap: word-wrap;
        }
        if (item.kind != SettingsItemKind.section && item.kind != SettingsItemKind.note) : SettingsRow {
            item: item;
            toggle-changed(v) => { root.item-toggle(item.key, v); }
            choice-picked(v) => { root.item-choice(item.key, v); }
            button-clicked => { root.item-button(item.key); }
        }
    }
}

export component SettingsWindow inherits Window {
    // ---- 数据（Rust 侧注入）----
    in-out property <[SettingsPage]> pages: [];
    in-out property <[SettingsItem]> items: [];
    // 主列表之后的设置项（原版部分 pageSection 位于热键列表之后；仅 hotkeys 页非空）
    in-out property <[SettingsItem]> items-after: [];
    in-out property <[SettingsMonitorEntry]> monitors: [];
    in-out property <[SettingsHotkey]> hotkeys: [];
    in-out property <string> active-page: "general";
    in-out property <bool> dark: false;
    in-out property <bool> win11: true;

    // ---- 本地化 ----
    in-out property <string> t-title: "Settings";
    in-out property <string> t-monitors-rename: "";
    in-out property <string> t-monitors-hide: "";
    in-out property <string> t-monitors-gamma: "";
    in-out property <string> t-monitors-sdr: "";
    in-out property <string> t-monitors-extend-minimum: "";
    in-out property <string> t-hotkeys-add: "";
    in-out property <string> t-hotkeys-remove: "";
    in-out property <string> t-hotkeys-record: "";
    in-out property <string> t-ddc-warning: "";
    in-out property <string> t-move-up: "";
    in-out property <string> t-move-down: "";
    in-out property <string> t-all-displays: "";
    in-out property <string> t-no-displays: "";
    in-out property <string> t-minimum: "";
    in-out property <string> t-maximum: "";
    in-out property <string> t-calibration-point: "";
    in-out property <string> t-delete: "";
    in-out property <string> t-calibration-input: "";
    in-out property <string> t-calibration-output: "";

    // ---- 回调（Rust 侧接线）----
    callback page-changed(string);
    callback item-toggle(string, bool);
    callback item-choice(string, string);
    callback item-button(string);
    callback monitor-renamed(string, string);
    callback monitor-hidden(string, bool);
    callback monitor-gamma(string, bool);
    callback monitor-sdr(string, bool);
    callback monitor-extend-minimum(string, bool);
    callback monitor-breakpoint(string, int);
    callback monitor-moved(string, int);
    // 亮度归一化：monitor id + "min"/"max" + 值
    callback monitor-remap(string, string, float);
    // 校准点：monitor id + 索引 + 字段（"input"/"output"）+ 值
    callback calibration-changed(string, int, string, float);
    callback calibration-added(string);
    callback calibration-removed(string, int);
    callback hotkey-add;
    callback hotkey-remove(string);
    callback hotkey-record(string);
    callback window-minimize;
    callback window-maximize;
    callback window-close;

    title: root.t-title;
    no-frame: true;
    // 无边框窗口的拖边框改宽（equiv Electron resizable:true 的 -webkit-app-region 无关部分）：
    // Slint 在无边框可调窗口上按此宽度把边缘按下转成系统缩放。取 6px 是为了让标题栏
    // 顶部的拖动区域不会整段被"上边框缩放"吞掉（4px 是 Slint 默认值）。
    resize-border-width: 6px;
    background: Theme.page-bg;
    width: 760px;
    height: 560px;

    VerticalLayout {
        // ---- 标题栏（equiv Titlebar.jsx + .window-titlebar）----
        Rectangle {
            height: 32px;
            background: transparent;
            // 拖动区域（equiv .titlebar-drag-region 的 -webkit-app-region: drag）：
            // 铺满整条标题栏并作为第一个子元素，窗口按钮（touch-area 与窗口相关的
            // 元素）在其之上独立拦截，等价原版 .window-controls-container 的 no-drag。
            WindowMoveArea { }
            // 标题 + 三枚窗口按钮都排在这层里（不设 wide/height，避免与拖动区域抢布局）
            HorizontalLayout {
                padding-left: 12px;
                Text {
                    text: root.t-title;
                    font-size: 12px;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 44px;
                    height: 32px;
                    background: ta1.has-hover ? Theme.sidebar-item-hover : transparent;
                    Text { text: "\u{e921}"; font-family: "Segoe MDL2 Assets"; font-size: 10px; color: Theme.text; vertical-alignment: center; horizontal-alignment: center; }
                    ta1 := TouchArea { clicked => { root.window-minimize(); } }
                }
                Rectangle {
                    width: 44px;
                    height: 32px;
                    background: ta2.has-hover ? Theme.sidebar-item-hover : transparent;
                    Text { text: "\u{e922}"; font-family: "Segoe MDL2 Assets"; font-size: 10px; color: Theme.text; vertical-alignment: center; horizontal-alignment: center; }
                    ta2 := TouchArea { clicked => { root.window-maximize(); } }
                }
                Rectangle {
                    width: 44px;
                    height: 32px;
                    background: ta3.has-hover ? #c42b1c : transparent;
                    Text { text: "\u{e8bb}"; font-family: "Segoe MDL2 Assets"; font-size: 10px; color: ta3.has-hover ? #ffffff : Theme.text; vertical-alignment: center; horizontal-alignment: center; }
                    ta3 := TouchArea { clicked => { root.window-close(); } }
                }
            }
        }

        HorizontalLayout {
            // ---- 侧边栏（equiv #sidebar）----
            Rectangle {
                width: 180px;
                background: transparent;
                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    for page in root.pages : NavItem {
                        label: page.label;
                        glyph: page.glyph;
                        active: root.active-page == page.id;
                        clicked => { root.page-changed(page.id); }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }

            // ---- 内容区 ----
            Rectangle {
                background: Theme.page-bg;
                horizontal-stretch: 1;
                ScrollView {
                    content-width: self.width;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 4px;

                        // 通用设置页（general / features / time / updates / light-sensor / debug）
                        if (root.active-page != "monitors" && root.active-page != "hotkeys") : SettingsItems {
                            items: root.items;
                            item-toggle(k, v) => { root.item-toggle(k, v); }
                            item-choice(k, v) => { root.item-choice(k, v); }
                            item-button(k) => { root.item-button(k); }
                        }

                        // 显示器页（equiv SettingsWindow.jsx L1527-L1578 的三段结构）
                        //   1) All Displays：每台显示器的详情（getInfoMonitors）
                        //   2) SettingsOption 序列：亮度更新率 / 隐藏内屏 / 睡眠动作 / 电源值 / 平衡亮度说明
                        //   3) 逐台控制：重命名 / 隐藏 / 排序 / gamma / extend minimum / SDR
                        if (root.active-page == "monitors") : VerticalLayout {
                            spacing: 8px;

                            // ---- 第 1 段：所有显示器（equiv getInfoMonitors L857-L887）----
                            Rectangle {
                                height: 34px;
                                background: transparent;
                                Text {
                                    text: root.t-all-displays;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Theme.text;
                                    vertical-alignment: bottom;
                                }
                            }
                            if (root.monitors.length == 0) : Text {
                                text: root.t-no-displays;
                                font-size: 12px;
                                color: Theme.text-mid;
                                wrap: word-wrap;
                            }
                            for monitor in root.monitors : Rectangle {
                                height: info.preferred-height + 16px;
                                border-radius: 4px;
                                background: Theme.page-section-bg;
                                info := VerticalLayout {
                                    padding: 8px;
                                    spacing: 4px;
                                    Text {
                                        text: monitor.title;
                                        font-size: 12px;
                                        font-weight: 600;
                                        color: Theme.text;
                                        wrap: word-wrap;
                                    }
                                    Text {
                                        text: monitor.details;
                                        font-size: 11px;
                                        color: Theme.text-mid;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // ---- 第 2 段：全局设置项（equiv L1536-L1569）----
                            SettingsItems {
                                items: root.items;
                                item-toggle(k, v) => { root.item-toggle(k, v); }
                                item-choice(k, v) => { root.item-choice(k, v); }
                                item-button(k) => { root.item-button(k); }
                            }

                            // ---- 第 3 段：逐台显示器控制（equiv hide/rename/reorder/gamma/extend/SDR）----
                            for monitor in root.monitors : Rectangle {
                                height: ctrl.preferred-height + 12px;
                                border-radius: 4px;
                                background: Theme.page-section-bg;
                                ctrl := VerticalLayout {
                                    padding: 8px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        spacing: 4px;
                                        Text {
                                            text: monitor.name;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: Theme.text;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: up.has-hover ? Theme.button-bg : transparent;
                                            Text { text: "\u{e70e}"; font-family: "Segoe MDL2 Assets"; font-size: 12px; color: Theme.text-mid; vertical-alignment: center; horizontal-alignment: center; }
                                            up := TouchArea { clicked => { root.monitor-moved(monitor.key, -1); } }
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: down.has-hover ? Theme.button-bg : transparent;
                                            Text { text: "\u{e70d}"; font-family: "Segoe MDL2 Assets"; font-size: 12px; color: Theme.text-mid; vertical-alignment: center; horizontal-alignment: center; }
                                            down := TouchArea { clicked => { root.monitor-moved(monitor.key, 1); } }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: monitor.connection; font-size: 11px; color: Theme.text-mid; vertical-alignment: center; }
                                        LineEdit {
                                            text: monitor.rename;
                                            placeholder-text: root.t-monitors-rename;
                                            horizontal-stretch: 1;
                                            accepted(t) => { root.monitor-renamed(monitor.key, t); }
                                        }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: root.t-monitors-hide; font-size: 11px; color: Theme.text-mid; vertical-alignment: center; }
                                        Toggle { checked: monitor.hidden; toggled(v) => { root.monitor-hidden(monitor.key, v); } }
                                        Text { text: root.t-monitors-gamma; font-size: 11px; color: Theme.text-mid; vertical-alignment: center; }
                                        Toggle { checked: monitor.gamma; toggled(v) => { root.monitor-gamma(monitor.key, v); } }
                                        Text { text: root.t-monitors-sdr; font-size: 11px; color: Theme.text-mid; vertical-alignment: center; }
                                        Toggle { checked: monitor.sdr; toggled(v) => { root.monitor-sdr(monitor.key, v); } }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: root.t-monitors-extend-minimum; font-size: 11px; color: Theme.text-mid; vertical-alignment: center; }
                                        Toggle { checked: monitor.extend-minimum; toggled(v) => { root.monitor-extend-minimum(monitor.key, v); } }
                                        if (monitor.extend-minimum) : LineEdit {
                                            width: 60px;
                                            text: "\{monitor.breakpoint}";
                                            horizontal-alignment: center;
                                            accepted(t) => { root.monitor-breakpoint(monitor.key, t.to-float()); }
                                        }
                                        Rectangle { horizontal-stretch: 1; background: transparent; }
                                    }

                                    // ---- 亮度归一化（equiv getMinMaxMonitors L465-L507 的 Min/Max 滑块）----
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: root.t-minimum; font-size: 11px; color: Theme.text-mid; vertical-alignment: center; width: 40px; }
                                        MiniSlider {
                                            level: monitor.remap-min;
                                            minimum: 0;
                                            maximum: 100;
                                            horizontal-stretch: 1;
                                            changed(v) => { root.monitor-remap(monitor.id, "min", v); }
                                        }
                                        Text { text: "\{round(monitor.remap-min)}"; font-size: 11px; color: Theme.text; vertical-alignment: center; width: 28px; horizontal-alignment: right; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: root.t-maximum; font-size: 11px; color: Theme.text-mid; vertical-alignment: center; width: 40px; }
                                        MiniSlider {
                                            level: monitor.remap-max;
                                            minimum: 0;
                                            maximum: 100;
                                            horizontal-stretch: 1;
                                            changed(v) => { root.monitor-remap(monitor.id, "max", v); }
                                        }
                                        Text { text: "\{round(monitor.remap-max)}"; font-size: 11px; color: Theme.text; vertical-alignment: center; width: 28px; horizontal-alignment: right; }
                                    }

                                    // ---- 校准点（equiv getMonitorCalibration L509-L534）----
                                    for point in monitor.calibration : HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: root.t-calibration-input; font-size: 11px; color: Theme.text-mid; vertical-alignment: center; }
                                        MiniSlider {
                                            level: point.input;
                                            horizontal-stretch: 1;
                                            changed(v) => { root.calibration-changed(monitor.id, point.index, "input", v); }
                                        }
                                        Text { text: "\{round(point.input)}"; font-size: 11px; color: Theme.text; vertical-alignment: center; width: 28px; horizontal-alignment: right; }
                                        Text { text: root.t-calibration-output; font-size: 11px; color: Theme.text-mid; vertical-alignment: center; }
                                        MiniSlider {
                                            level: point.output;
                                            horizontal-stretch: 1;
                                            changed(v) => { root.calibration-changed(monitor.id, point.index, "output", v); }
                                        }
                                        Text { text: "\{round(point.output)}"; font-size: 11px; color: Theme.text; vertical-alignment: center; width: 28px; horizontal-alignment: right; }
                                        Rectangle {
                                            width: 26px;
                                            height: 20px;
                                            border-radius: 4px;
                                            background: del.has-hover ? Theme.button-bg : transparent;
                                            Text { text: "\u{e74d}"; font-family: "Segoe MDL2 Assets"; font-size: 11px; color: Theme.text; vertical-alignment: center; horizontal-alignment: center; }
                                            del := TouchArea { clicked => { root.calibration-removed(monitor.id, point.index); } }
                                        }
                                    }
                                    Rectangle {
                                        height: 24px;
                                        width: 170px;
                                        border-radius: 4px;
                                        background: Theme.button-bg;
                                        border-width: 1px;
                                        border-color: Theme.button-border;
                                        Text { text: "+ " + root.t-calibration-point; font-size: 11px; color: Theme.text; vertical-alignment: center; horizontal-alignment: center; }
                                        TouchArea { clicked => { root.calibration-added(monitor.id); } }
                                    }
                                }
                            }
                        }

                        // 热键页（equiv hotkeys 页 L1608-L1668：
                        //   列表前设置项 → 热键列表 + 新增 → 列表后设置项）
                        if (root.active-page == "hotkeys") : VerticalLayout {
                            spacing: 6px;
                            // 标题/说明/原生亮度警告（equiv L1609-L1618）
                            SettingsItems {
                                items: root.items;
                                item-toggle(k, v) => { root.item-toggle(k, v); }
                                item-choice(k, v) => { root.item-choice(k, v); }
                                item-button(k) => { root.item-button(k); }
                            }
                            // 热键列表（equiv getHotkeyList L753-L820 的简化行 +
                            // "+ Add Hotkey" L1619-L1625；原版列表为空时无占位文本）
                            for hotkey in root.hotkeys : Rectangle {
                                height: 40px;
                                border-radius: 4px;
                                background: Theme.page-section-bg;
                                HorizontalLayout {
                                    padding: 8px;
                                    spacing: 8px;
                                    Text {
                                        text: hotkey.accelerator;
                                        font-size: 12px;
                                        font-family: "Consolas";
                                        color: Theme.text;
                                        vertical-alignment: center;
                                        width: 140px;
                                    }
                                    Text {
                                        text: hotkey.summary;
                                        font-size: 12px;
                                        color: Theme.text-mid;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Rectangle {
                                        width: 70px;
                                        height: 24px;
                                        border-radius: 4px;
                                        background: Theme.button-bg;
                                        border-width: 1px;
                                        border-color: Theme.button-border;
                                        Text { text: root.t-hotkeys-record; font-size: 11px; color: Theme.text; vertical-alignment: center; horizontal-alignment: center; }
                                        TouchArea { clicked => { root.hotkey-record(hotkey.id); } }
                                    }
                                    Rectangle {
                                        width: 26px;
                                        height: 24px;
                                        border-radius: 4px;
                                        background: Theme.button-bg;
                                        border-width: 1px;
                                        border-color: Theme.button-border;
                                        Text { text: "\u{e74d}"; font-family: "Segoe MDL2 Assets"; font-size: 12px; color: Theme.text; vertical-alignment: center; horizontal-alignment: center; }
                                        TouchArea { clicked => { root.hotkey-remove(hotkey.id); } }
                                    }
                                }
                            }
                            Rectangle {
                                height: 28px;
                                width: 140px;
                                border-radius: 4px;
                                background: Theme.button-bg;
                                border-width: 1px;
                                border-color: Theme.button-border;
                                Text { text: "+ " + root.t-hotkeys-add; font-size: 12px; color: Theme.text; vertical-alignment: center; horizontal-alignment: center; }
                                TouchArea { clicked => { root.hotkey-add(); } }
                            }
                            // 列表后设置项：break linked levels / 滚动 / TOD（equiv L1627-L1667）
                            SettingsItems {
                                items: root.items-after;
                                item-toggle(k, v) => { root.item-toggle(k, v); }
                                item-choice(k, v) => { root.item-choice(k, v); }
                                item-button(k) => { root.item-button(k); }
                            }
                        }

                        Rectangle { height: 16px; background: transparent; }
                    }
                }
            }
        }
    }
}
// 单一编译入口（slint-build 的 include_modules! 只含最后一次 compile 的组件；
// 用一个入口文件聚合四个窗口，等价 parcel 多入口构建语义）
import { PanelWindow } from "panel.slint";
import { SettingsWindow } from "settings.slint";
import { IntroWindow } from "intro.slint";
import { HudWindow } from "hud.slint";
import { Theme } from "theme.slint";
// 内置 Palette 全局（fluent std-widgets 的配色来源，color-scheme 属性可写）。
// re-export 给 Rust 侧：应用主题（theme=dark/light/default）必须同步到该全局，
// 否则 ComboBox/LineEdit 等 std-widgets 的深浅色只跟随系统设置，与应用主题脱节。
// 四窗口同属本编译单元，Palette 全局实例共享，任一窗口设置即全部生效。
import { Palette } from "std-widgets.slint";

export { PanelWindow, SettingsWindow, IntroWindow, HudWindow, Theme }

export { Palette }
